// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  userId String @id @default(uuid())
  name   String
  email  String @unique
  password String
  role  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profile Profile?
  products Products[]
  auctions Auctions[]
  cartItems CartItems[]
  bids Bids[]
  purchases Purchases[]
  reviewsReceived Reviews[] @relation("ReviewedUser")
  reviewsWritten  Reviews[] @relation("Reviewer")
  productReviewsWritten ProductReviews[] @relation("ProductReviewer")
}


model Profile {
  profileId      String    @id @default(uuid())
  userId         String    @unique

  gender         String?
  contactNumber  String?
  birthday       DateTime?

  user      Users     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  addresses Address[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Address {
  addressId     String  @id @default(uuid())
  profileId     String

  label         String
  name          String
  contactNumber String?
  streetName    String?
  postalCode    String?
  region        String?
  province      String?
  city          String?
  barangay      String?
  regionCode    String?
  provinceCode  String?
  cityCode      String?
  barangayCode  String?
  isDefault     Boolean @default(false)

  profile Profile @relation(fields: [profileId], references: [profileId], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([profileId])
}

model Products {
  productId        String   @id @default(uuid())
  userId           String
  name             String
  price            Float
  rating           Float?
  productCategory  String
  brand            String
  condition        String
  stockQuantity    Int
  status           String
  description      String
  paymentMethods   String[] @default([])
  meetupLocations  Json     @default(dbgenerated("'[]'::jsonb"))
  shippingDetails  String?
  owner            Users    @relation(fields: [userId], references: [userId])
  Sales            Sales[]
  Purchases        Purchases[]
  cartItems        CartItems[]
  productReviews   ProductReviews[]
}

model Auctions {
  productId        String    @id @default(uuid())
  userId           String
  name             String
  price            Float
  rating           Float?
  productCategory  String
  brand            String
  condition        String
  stockQuantity    Int
  status           String
  description      String
  paymentMethods   String[]  @default([])
  meetupLocations  Json      @default(dbgenerated("'[]'::jsonb"))
  shippingDetails  String?
  biddingEndsAt    DateTime
  bidCount         Int       @default(0)
  winningBidId     String?   @unique
  settledAt        DateTime?
  owner            Users     @relation(fields: [userId], references: [userId])
  bids             Bids[]    @relation("AuctionBids")
  winningBid       Bids?     @relation("AuctionWinner", fields: [winningBidId], references: [bidId], onDelete: SetNull)

  @@index([biddingEndsAt])
  @@index([settledAt])
}

model CartItems {
  cartItemId String   @id @default(uuid())
  userId     String
  productId  String
  quantity   Int      @default(1)
  currency   String   @default("₱")

  user    Users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  product Products @relation(fields: [productId], references: [productId], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userId, productId])
}

model Bids {
  bidId      String @id @default(uuid())
  userId     String
  productId  String
  offerPrice Float
  currency   String @default("₱")

  user       Users     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  auction    Auctions  @relation("AuctionBids", fields: [productId], references: [productId], onDelete: Cascade)
  wonAuction Auctions? @relation("AuctionWinner")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Sales {
  saleId      String   @id
  productId   String
  timestamp   DateTime
  quantity    Int
  unitPrice   Float
  totalAmount Float
  product     Products @relation(fields: [productId], references: [productId])
}

model Purchases {
  purchaseId String   @id
  productId  String
  userId     String?
  orderId    String?
  timestamp  DateTime
  quantity   Int
  unitCost   Float
  totalCost  Float
  product    Products @relation(fields: [productId], references: [productId])
  buyer      Users?   @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
}

model Expenses {
  expenseId String   @id
  category  String
  amount    Float
  timestamp DateTime
}

model SalesSummary {
  salesSummaryId   String   @id
  totalValue       Float
  changePercentage Float?
  date             DateTime
}

model PurchaseSummary {
  purchaseSummaryId String   @id
  totalPurchased    Float
  changePercentage  Float?
  date              DateTime
}

model ExpenseSummary {
  expenseSummaryId  String              @id
  totalExpenses     Float
  date              DateTime
  ExpenseByCategory ExpenseByCategory[]
}

model ExpenseByCategory {
  expenseByCategoryId String         @id
  expenseSummaryId    String
  category            String
  amount              BigInt
  date                DateTime
  expenseSummary      ExpenseSummary @relation(fields: [expenseSummaryId], references: [expenseSummaryId])
}

model Reviews {
  reviewId     String  @id @default(uuid())
  userId       String
  reviewerId   String
  orderId      String?
  rating       Int
  comment      String

  reviewedUser Users @relation("ReviewedUser", fields: [userId], references: [userId])
  reviewer     Users @relation("Reviewer", fields: [reviewerId], references: [userId])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([userId, reviewerId, orderId])
  @@index([userId])
  @@index([orderId])
}

model ProductReviews {
  productReviewId String  @id @default(uuid())
  productId       String
  reviewerId      String
  orderId         String?
  rating          Int
  comment         String  @default("")

  product  Products @relation(fields: [productId], references: [productId], onDelete: Cascade)
  reviewer Users    @relation("ProductReviewer", fields: [reviewerId], references: [userId], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([productId, reviewerId, orderId])
  @@index([productId])
  @@index([orderId])
}